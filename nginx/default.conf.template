# nginx 설정 (배포용)
# - 빌드된 React 정적 파일(dist)을 제공
# - /api 요청은 Spring Boot 로 전달 → 개발 때 Vite 프록시가 하던 일을 nginx 가 대신함
# - ${BACKEND_URL} 은 컨테이너 시작 시 환경 변수 값으로 치환됨
#   (nginx 공식 이미지가 /etc/nginx/templates/*.template 을 자동 치환)
#   기본값은 Dockerfile 의 ENV BACKEND_URL=http://app:8080 (compose 서비스 이름 app)

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # /api/memos → ${BACKEND_URL}/memos (끝의 / 가 /api 를 잘라 줌)
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 그 밖의 경로는 React 가 처리 (새로고침해도 index.html 로)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
